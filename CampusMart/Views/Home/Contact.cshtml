@{
    ViewData["Title"] = "Contact";
}

<section class="border-b border-white/10 py-14 md:py-16">
    <div class="cm-container">
        <p class="cm-eyebrow mb-3">Contact</p>
        <h1 class="cm-page-title">Get support from CampusMart</h1>
        <p class="cm-page-lead mt-4">
            If you have questions, feedback, or account concerns, use one of the channels below.
        </p>
    </div>
</section>

<section class="py-12 md:py-14">
    <div class="cm-container">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <article class="cm-surface p-5">
                <h2 class="text-base font-semibold text-slate-100">Email</h2>
                <p class="mt-2 text-sm text-campus-muted">support@campusmart.edu</p>
                <p class="mt-1 text-sm text-campus-muted">Expected response: within 24 hours.</p>
            </article>

            <article class="cm-surface p-5">
                <h2 class="text-base font-semibold text-slate-100">Campus office</h2>
                <p class="mt-2 text-sm text-campus-muted">Student Union Building, Room 204</p>
                <p class="mt-1 text-sm text-campus-muted">Monday to Friday, 9:00 AM to 5:00 PM.</p>
            </article>

            <article class="cm-surface p-5">
                <h2 class="text-base font-semibold text-slate-100">In-app support</h2>
                <p class="mt-2 text-sm text-campus-muted">Available during business hours for account and order assistance.</p>
            </article>
        </div>
    </div>
</section>

<section class="border-t border-white/10 py-12 md:py-14">
    <div class="cm-container">
        <div class="cm-surface p-6 md:p-8">
            <h2 class="text-2xl font-bold text-slate-50">Need help with an order?</h2>
            <p class="mt-3 text-campus-muted">For faster support, include your order number and account email in your message.</p>
            <div class="mt-6 flex flex-wrap gap-3">
                <a asp-controller="Account" asp-action="Login" class="cm-button-primary">Sign in</a>
                <a asp-controller="Home" asp-action="HomeIndex" class="cm-button-secondary">Back to home</a>
            </div>
        </div>
    </div>
</section>
